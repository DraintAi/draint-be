# ── drain't backend env ──────────────────────────────────────────

# ── Venice AI (brain) ────────────────────────────────────────────
# Register: https://venice.ai/api
# OpenAI-compatible endpoint
VENICE_API_KEY=
VENICE_API_BASE=https://api.venice.ai/api/v1
VENICE_MODEL=glm-5.1

# ── 1Shot Permissionless Relayer (rescue) ────────────────────────
# Register: https://1shotapi.com
# REQUIRED for Best 1Shot Relayer track
ONESHOT_API_KEY=
ONESHOT_API_BASE=https://relayer.1shotapi.com/relayers

# ── Ethereum RPC ─────────────────────────────────────────────────
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Note: eth.llamarpc.com has SSL handshake issues from some regions; use publicnode by default.

# ── Deployed drain't contracts ───────────────────────────────────
# Sepolia DraintCuratedTargetsEnforcer (live + verified)
# https://sepolia.etherscan.io/address/0x2187d61279a8a54dc8907865959ef6cc8bebda14
ALLOWLIST_ENFORCER_SEPOLIA=0x2187D61279a8A54dc8907865959ef6cC8beBDa14
ALLOWLIST_ENFORCER_MAINNET=

# ── Etherscan (bytecode/source lookup) ───────────────────────────
ETHERSCAN_API_KEY=

# ── Upstash Redis (classifier cache) ─────────────────────────────
# Provision via Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── drain't agent identity ───────────────────────────────────────
# The on-chain address that receives ERC-7710 delegation
# Generate via: cast wallet new (do NOT reuse main wallet)
DRAINT_AGENT_PRIVATE_KEY=
DRAINT_AGENT_ADDRESS=

# ── App config ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
